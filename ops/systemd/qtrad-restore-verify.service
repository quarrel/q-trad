[Unit]
Description=q-trad PostgreSQL isolated restore verification
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/qtrad-capture
EnvironmentFile=/etc/qtrad/capture-backup.env
Environment=QTRAD_RESTORE_ROOT=/srv/qtrad/postgres/restore-verification
ExecStart=/opt/qtrad-capture/ops/capture/restore-verify.sh
UMask=0077
