[Unit]
Description=q-trad bounded demo market-data ingestion
Requires=qtrad-capture.service
After=qtrad-capture.service
PartOf=qtrad-capture.service
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/opt/qtrad-capture
ExecStart=/usr/bin/docker compose --env-file /etc/qtrad/capture.env --project-directory /opt/qtrad-capture -f compose.capture.yaml up --no-deps --abort-on-container-exit --exit-code-from ingest ingest
ExecStop=/usr/bin/docker compose --env-file /etc/qtrad/capture.env --project-directory /opt/qtrad-capture -f compose.capture.yaml stop --timeout 90 ingest
Restart=on-failure
RestartSec=60
TimeoutStartSec=120
TimeoutStopSec=120

[Install]
WantedBy=qtrad-capture.service
