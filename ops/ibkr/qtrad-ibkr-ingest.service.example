[Unit]
Description=q-trad IBKR market-data ingest
Requires=docker.service qtrad-ibgateway.service
After=docker.service qtrad-ibgateway.service
RequiresMountsFor=/srv/qtrad/postgres

[Service]
Type=simple
EnvironmentFile=/etc/qtrad/ibkr-ingest.env
ExecStart=/usr/local/sbin/qtrad-ibkr-ingest
ExecStop=/usr/bin/docker stop --time 90 qtrad-ibkr-ingest
Restart=always
RestartSec=15
StartLimitIntervalSec=1h
StartLimitBurst=3
KillMode=control-group
TimeoutStopSec=120
# The wrapper must run host networking, localhost Gateway access and an immutable image digest.

[Install]
WantedBy=multi-user.target
