[Unit]
Description=q-trad IBKR native Level-1 ingest
Requires=docker.service qtrad-ibgateway.service qtrad-ibkr-postgres.service
After=docker.service qtrad-ibgateway.service qtrad-ibkr-postgres.service
RequiresMountsFor=/srv/qtrad/postgres
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=simple
User=root
EnvironmentFile=/etc/qtrad/ibkr-ingest.env
ExecStartPre=/usr/bin/timeout 120 /bin/bash -c 'until /usr/local/sbin/qtrad-ibgateway-listener-check; do /usr/bin/sleep 2; done'
ExecStart=/usr/local/sbin/qtrad-ibkr-ingest
ExecStop=/bin/bash -c 'exec /usr/bin/docker stop --timeout 90 qtrad-ibkr-ingest'
Restart=always
RestartSec=15
KillMode=control-group
TimeoutStopSec=120
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
