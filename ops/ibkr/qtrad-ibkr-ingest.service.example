[Unit]
Description=q-trad IBKR market-data ingest (future continuous adapter)
Requires=docker.service qtrad-ibgateway.service qtrad-ibkr-postgres.service
After=docker.service qtrad-ibgateway.service qtrad-ibkr-postgres.service
RequiresMountsFor=/srv/qtrad/postgres
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=simple
EnvironmentFile=/etc/qtrad/ibkr-ingest.env
ExecStart=/usr/local/sbin/qtrad-ibkr-ingest
ExecStop=/usr/bin/docker stop --time 90 qtrad-ibkr-ingest
Restart=always
RestartSec=15
KillMode=control-group
TimeoutStopSec=120
# This unit remains an example until the continuous IBKR adapter and API service exist.

[Install]
WantedBy=multi-user.target
