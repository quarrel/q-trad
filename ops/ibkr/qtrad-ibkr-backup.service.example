[Unit]
Description=Back up q-trad IBKR PostgreSQL
RequiresMountsFor=/srv/qtrad/postgres
Requires=qtrad-ibkr-postgres.service
After=qtrad-ibkr-postgres.service qtrad-ibkr-ingest.service

[Service]
Type=oneshot
EnvironmentFile=/etc/qtrad/ibkr-backup.env
ExecStart=/usr/local/sbin/qtrad-ibkr-postgres-backup
