[Unit]
Description=Verify the latest q-trad IBKR PostgreSQL backup
RequiresMountsFor=/srv/qtrad/postgres
Requires=qtrad-ibkr-postgres.service
After=qtrad-ibkr-postgres.service

[Service]
Type=oneshot
EnvironmentFile=/etc/qtrad/ibkr-backup.env
ExecStart=/usr/local/sbin/qtrad-ibkr-postgres-restore-verify
