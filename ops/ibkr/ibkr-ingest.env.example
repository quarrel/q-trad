# Non-secret identity and paths only. Install a root-owned, mode-0640 copy.
QTRAD_PROVIDER=ibkr
QTRAD_IMAGE=registry.example.invalid/qtrad@sha256:REPLACE_WITH_64_HEX_DIGEST
QTRAD_IBKR_IMAGE=registry.example.invalid/qtrad@sha256:REPLACE_WITH_64_HEX_DIGEST
QTRAD_DATABASE_URL=postgresql+asyncpg://qtrad_ibkr@127.0.0.1:5432/qtrad_ibkr
QTRAD_MIGRATION_DATABASE_URL=postgresql+psycopg://qtrad_ibkr@127.0.0.1:5432/qtrad_ibkr
# Keep b3-exact-two until a real B3 qualification and reviewed B4 release exist.
QTRAD_IBKR_RELEASE_POLICY=b3-exact-two
QTRAD_IBKR_CAPTURE_CONFIGURATION_PATH=/etc/qtrad/ibkr-b3-capture.json
QTRAD_IBKR_CAPTURE_CONFIGURATION_HASH=REPLACE_WITH_64_HEX_DIGEST
QTRAD_IBKR_SYSTEM_URL=http://127.0.0.1:8000/api/v1/system
QTRAD_IBKR_HEALTH_STATE_DIR=/var/lib/qtrad/ibkr
QTRAD_IBKR_RESTART_HISTORY_PATH=/var/lib/qtrad/ibkr/gateway-restarts
QTRAD_IBKR_CHECKPOINT_ROOT=/srv/qtrad/postgres/qtrad-ibkr-checkpoints
QTRAD_IBKR_MAX_GATEWAY_RESTARTS_PER_HOUR=3
QTRAD_IBKR_GATEWAY_ARCHIVE_SHA256=REPLACE_WITH_64_HEX_DIGEST
QTRAD_IBKR_GATEWAY_MANIFEST=/etc/qtrad/ibkr-gateway-manifest.json
QTRAD_IBKR_API_PACKAGE_FINGERPRINT=REPLACE_WITH_64_HEX_DIGEST
QTRAD_IBKR_GATEWAY_HOST=127.0.0.1
QTRAD_IBKR_GATEWAY_PORT=4002
QTRAD_IBKR_API_HOST=127.0.0.1
QTRAD_IBKR_API_PORT=8000
QTRAD_IBKR_CLIENT_ID=71
QTRAD_IBKR_CLIENT_ID_POLICY=DEDICATED_NONZERO_CLIENT_ID
QTRAD_IBKR_API_VERSION=10.49
QTRAD_IBKR_GATEWAY_VERSION=10.49
QTRAD_IBKR_IBC_VERSION=3.24.1
QTRAD_IBKR_DATABASE_NAME=qtrad_ibkr
