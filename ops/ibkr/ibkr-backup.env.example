# Root-owned mode-0600 file. Database authentication stays inside the PostgreSQL container.
QTRAD_IBKR_BACKUP_DIR=/srv/qtrad/postgres/backups
QTRAD_IBKR_STATUS_DIR=/var/lib/qtrad
QTRAD_IBKR_POSTGRES_CONTAINER=qtrad-postgres
QTRAD_IBKR_POSTGRES_DATABASE=qtrad
QTRAD_IBKR_POSTGRES_USER=qtrad
QTRAD_IBKR_BACKUP_RETENTION_DAYS=14
