# Root-readable deployment metadata only; put IBC credentials in its protected config.
QTRAD_IBKR_GATEWAY_VERSION=10.49
QTRAD_IBKR_GATEWAY_ARCHIVE_SHA256=REPLACE_WITH_64_HEX_DIGEST
QTRAD_IBKR_GATEWAY_MANIFEST=/etc/qtrad/ibkr-gateway-manifest.json
QTRAD_IBKR_API_PORT=4002
QTRAD_IBC_VERSION=3.24.1
QTRAD_IBKR_GATEWAY_INSTALL_ROOT=/opt/ibgateway
QTRAD_IBC_INSTALL_ROOT=/opt/ibc
QTRAD_IBKR_GATEWAY_SETTINGS=/srv/ibgateway/settings
# Absolute executable supplied by the installed IBC release.
QTRAD_IBC_LAUNCHER=/absolute/path/to/verified/ibc-launcher
# Installed copy of ops/ibkr/gateway-config-check.sh.
QTRAD_IBKR_GATEWAY_CONFIG_CHECK=/usr/local/sbin/qtrad-ibkr-gateway-config-check
# Local machine time; the checker accepts HH:MM, HH:MM:SS or 12-hour notation.
QTRAD_IBKR_AUTO_RESTART_TIME=22:30:00
