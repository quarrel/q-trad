[Unit]
Description=q-trad IB Gateway and IBC
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=simple
User=ibgateway
Group=ibgateway
EnvironmentFile=/etc/qtrad/ibkr-gateway.env
ExecStart=/usr/local/sbin/qtrad-ibgateway
Restart=always
RestartSec=15
KillMode=control-group
TimeoutStopSec=90
# The wrapper validates paper/read-only/localhost settings and owns the licensed archives and daily AutoRestartTime.

[Install]
WantedBy=multi-user.target
