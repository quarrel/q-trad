[Unit]
Description=q-trad IB Gateway and IBC
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ibgateway
Group=ibgateway
EnvironmentFile=/etc/qtrad/ibkr-gateway.env
ExecStart=/usr/local/sbin/qtrad-ibgateway
Restart=always
RestartSec=15
StartLimitIntervalSec=1h
StartLimitBurst=3
KillMode=control-group
TimeoutStopSec=90
# The wrapper owns the licensed Gateway/IBC archives and daily AutoRestartTime.

[Install]
WantedBy=multi-user.target
