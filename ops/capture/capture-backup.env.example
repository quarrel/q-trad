# Root-owned mode-0600 file installed as /etc/qtrad/capture-backup.env.
# It contains no provider or database credentials.
QTRAD_CAPTURE_ROOT=/opt/qtrad-capture
QTRAD_CAPTURE_ENV=/etc/qtrad/capture.env
QTRAD_BACKUP_DIR=/srv/qtrad/postgres/backups
QTRAD_STATUS_DIR=/var/lib/qtrad-capture
QTRAD_BACKUP_BUCKET=qtrad-capture-backups
QTRAD_OCI_AUTH=instance_principal
QTRAD_WEEKLY_BACKUP_DAY=7
QTRAD_LOCAL_BACKUP_RETENTION_DAYS=2
QTRAD_EXPECTED_V1_MIGRATION_VERSION=0003
