# Root-owned mode-0600 file installed as /etc/qtrad/capture-monitor.env.
# The compartment OCID is an identifier, not a credential.
QTRAD_READY_URL=http://127.0.0.1:8000/health/ready
QTRAD_SYSTEM_URL=http://127.0.0.1:8000/api/v1/system
QTRAD_OCI_METRIC_NAMESPACE=qtrad_capture
QTRAD_OCI_COMPARTMENT_ID=ocid1.compartment.oc1..replace-me
QTRAD_OCI_TELEMETRY_ENDPOINT=https://telemetry-ingestion.ap-sydney-1.oraclecloud.com
QTRAD_STATUS_DIR=/var/lib/qtrad-capture
QTRAD_DATA_MOUNT=/srv/qtrad/postgres
QTRAD_OCI_AUTH=instance_principal
QTRAD_MAX_BACKUP_AGE_SECONDS=129600
QTRAD_MAX_RESTORE_AGE_SECONDS=691200
QTRAD_MIN_DISK_FREE_PERCENT=15
QTRAD_MAX_CLOCK_OFFSET_SECONDS=0.1
