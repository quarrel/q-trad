{
  "name": "q-trad",
  "dockerComposeFile": [
    "../compose.yaml",
    "compose.devcontainer.yaml"
  ],
  "service": "dev",
  "runServices": [
    "db",
    "test-db",
    "dev"
  ],
  "workspaceFolder": "/workspace",
  "shutdownAction": "none",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "initializeCommand": [
    "bash",
    "-lc",
    "mkdir -p .devcontainer/local && if [ -f \"$HOME/.codex/AGENTS.md\" ]; then cp \"$HOME/.codex/AGENTS.md\" .devcontainer/local/AGENTS.md; else : > .devcontainer/local/AGENTS.md; fi"
  ],
  "postCreateCommand": "uv run --no-project .devcontainer/post_install.py && uv sync --frozen",
  "postStartCommand": "rm -f /home/vscode/.codex/state_5.sqlite /home/vscode/.codex/app-server-daemon/app-server-updater.pid && uv run alembic upgrade head && codex remote-control stop && sh .devcontainer/start_remote_control.sh",
  "waitFor": "postCreateCommand",
  "mounts": [
    "source=/mnt/wsl/data/q-trad-bulkdata,target=/data,type=bind",
    "source=/mnt/wsl/data/q-trad-bulkdata/q-trad/retained-workspace-tmp/ibkr-historical-r2-20260810T081317Z,target=/workspace/tmp/ibkr-historical-r2-20260810T081317Z,type=bind,readonly",
    "source=/mnt/wsl/data/q-trad-bulkdata/q-trad/retained-workspace-tmp/r2-confirmatory-ibkr-historical-20260820T051751Z,target=/workspace/tmp/r2-confirmatory-ibkr-historical-20260820T051751Z,type=bind,readonly",
    "source=${localWorkspaceFolder}/tmp,target=/workspace-tmp-migration-source,type=bind"
  ],  
  "customizations": {
    "vscode": {
      "settings": {
        "python-envs.alwaysUseUv": true,
        "python.defaultInterpreterPath": "/workspace/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "terminal.integrated.defaultProfile.linux": "bash",
        "chatgpt.openOnStartup": true,
        "terminal.integrated.defaultLocation": "view",
        "workbench.startupEditor": "none"
      },
      "extensions": [
        "openai.chatgpt",
        "charliermarsh.ruff",
        "astral-sh.ty",
        "tamasfe.even-better-toml",
        "esbenp.prettier-vscode",
        "ms-python.python",
        "ms-python.vscode-python-envs",
        "mechatroner.rainbow-csv",
        "hiztam.codex-history-viewer"
      ]
    }
  }
}
