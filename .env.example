# IG demo credentials. Copy to .env; never commit populated values.
QTRAD_IG_USERNAME=
QTRAD_IG_PASSWORD=
QTRAD_IG_API_KEY=
QTRAD_IG_ACCOUNT_ID=
QTRAD_IG_ENVIRONMENT=demo

# Optional local settings.
QTRAD_API_PORT=8080
QTRAD_CAPTURE_SOURCE_ID=local-development
QTRAD_LOG_LEVEL=INFO

# Tailscale Auth For devcontainer
TS_AUTH_KEY=tskey-auth-XXXXXXXXXXXXXXXXXXXXXXXXXXXXX
